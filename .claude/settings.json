{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; case \"$f\" in *.g.dart|*.freezed.dart) ;; *.dart) dart format \"$f\" ;; esac; } 2>/dev/null || true",
            "statusMessage": "dart format"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/pstack_session_context.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\"",
            "statusMessage": "pstack context"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pstack@cursor-plugins": true
  },
  "extraKnownMarketplaces": {
    "cursor-plugins": {
      "source": {
        "source": "github",
        "repo": "cursor/plugins",
        "ref": "7a583913eb1b8d1a0ee76753d1a2cf072e7b54f9",
        "sparsePaths": [
          ".claude-plugin",
          "harness/pstack"
        ]
      }
    }
  }
}
